# ==============================================================================
# FOODERA EXPO 2026 - Lead Qualification Bot
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather (/newbot)
BOT_TOKEN=

# Optional: bot username without @. Used for deep-link examples / help text.
BOT_USERNAME=

# --- Database -----------------------------------------------------------------
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://foodera:secret@127.0.0.1:5432/foodera_leads
# SQLite (local quick test):
DATABASE_URL=sqlite+aiosqlite:///./foodera_bot.db

# Create tables automatically on startup. Set to false in production and use
# Alembic migrations (`alembic upgrade head`) instead.
AUTO_CREATE_TABLES=true

# Optional: Redis for FSM (multi-instance / persistent conversation state).
# Leave empty to use in-memory FSM storage (single instance).
REDIS_URL=

# --- Sales group (qualified exhibitor leads) ----------------------------------
# Negative group id, e.g. -1001234567890 (see README "how to find SALES_GROUP_ID")
SALES_GROUP_ID=
# Optional: forum topic id if the group uses Topics
SALES_GROUP_TOPIC_ID=

# Optional: separate group for visitor registrations (never mixed with exhibitors)
VISITOR_GROUP_ID=
VISITOR_GROUP_TOPIC_ID=

# Labels inside the lead card: "auto" = language of the lead, or force uz/ru
SALES_CARD_LANGUAGE=auto

# --- Access control -------------------------------------------------------------
# Comma separated numeric Telegram user ids (no @usernames)
ADMIN_USER_IDS=
# Allow any member of the sales group to change lead status via inline buttons.
# The sales group is private, so this is usually fine. Set false to restrict to ADMIN_USER_IDS.
ALLOW_GROUP_MANAGERS=true

# --- Bot behaviour --------------------------------------------------------------
DEFAULT_LANGUAGE=uz
LOG_LEVEL=INFO
# true = machine readable JSON logs (good for journald/ELK)
LOG_JSON=false

# Shown to users as support contact, e.g. foodera_support
SUPPORT_USERNAME=

# Timezone used in the lead card timestamp
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Qualification thresholds (all scores are 0-100) ----------------------------
HOT_MIN_SCORE=75
WARM_MIN_SCORE=55
COLD_MIN_SCORE=35
# Minimum classification that is pushed to SALES_GROUP_ID (hot | warm | cold)
QUALIFY_MIN_CLASSIFICATION=warm
REQUIRE_PHONE_FOR_SALES=true
REQUIRE_COMPANY_NAME_FOR_SALES=true

# --- Anti-spam / funnel ---------------------------------------------------------
# A user who completed an application in the last N hours is offered "update"
# instead of a brand new lead.
RECENT_APPLICATION_HOURS=24
# Unfinished (draft) applications are considered resumable for N hours.
DRAFT_TTL_HOURS=72
# Simple per-user flood control (actions per minute)
RATE_LIMIT_PER_MINUTE=30
# Prefix of the human readable lead code (FD000123 is shown on the card)
LEAD_CODE_PREFIX=FD

# --- Admin Panel (Fly.io) -------------------------------------------------------
# Web admin panel: analytics, leads, broadcast, chat, export - 2 languages
ADMIN_PANEL_ENABLED=true
ADMIN_PANEL_HOST=0.0.0.0
ADMIN_PANEL_PORT=8080
# Login for /admin (default admin/admin if empty password)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=admin
# Secret for session signing (change in production!)
ADMIN_PANEL_SECRET_KEY=change-me-to-random-string
ADMIN_PANEL_SESSION_TTL_HOURS=24

# --- Debug --------------------------------------------------------------------
# Log every SQL statement (development only, very verbose)
SQL_ECHO=false
